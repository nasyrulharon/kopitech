# Automatic HTTPS for kopitech.my (Let's Encrypt). Requires a DNS A record for
# kopitech.my pointing at this VPS, and port 443 open.
#
# Port 80 on this VPS is used by another site, so Caddy runs on 443 only and
# gets its certificate via the TLS-ALPN-01 challenge (over 443, no port 80).
# disable_redirects stops Caddy from trying to open the port-80 http->https
# redirect vhost, which it cannot bind here.

{
    auto_https disable_redirects
}

kopitech.my {
    encode zstd gzip
    reverse_proxy kopitech:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}
